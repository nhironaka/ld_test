{
    "name": "darkstore/php-slim",
    "description": "DarkStore storefront API (PHP)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7.9",
        "kevinrob/guzzle-cache-middleware": "^7.0",
        "launchdarkly/server-sdk": "^6.8",
        "monolog/monolog": "^3.5",
        "php-di/php-di": "^7.0",
        "nyholm/psr7": "^1.8",
        "nyholm/psr7-server": "^1.1",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/log": "^3.0",
        "slim/slim": "^4.13"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "DarkStore\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DarkStore\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "serve": "php -S localhost:8000 -t public",
        "test": "phpunit"
    }
}
